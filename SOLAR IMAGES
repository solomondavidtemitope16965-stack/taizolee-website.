.product-gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 32px;
}
.product-card {
  overflow: hidden;
  background: var(--white);
  border: 1px solid #e7eeea;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.product-card img {
  display: block;
  width: 100%;
  height: 220px;
  object-fit: cover;
}
.product-card h3 {
  margin: 0;
  padding: 16px 18px;
  color: var(--navy);
  font-size: 1rem;
}
@media (max-width: 650px) {
  .product-gallery {
    grid-template-columns: 1fr;
  }
}
